{
  "folders": [
    {
      "name": "[environment]",
      "path": ".",
    },
    {
      "name": "application-services",
      "path": "../../../../mozilla/application-services"
    },
  ],
  "settings": {
    "terminal.integrated.cwd": "${workspaceFolder:application-services}",
    "terminal.integrated.defaultProfile.linux": "fish [nix develop]",
    "terminal.integrated.defaultProfile.osx": "fish [nix develop]",
    "terminal.integrated.profiles.linux": {
      "fish [nix develop]": {
        "path": "nix",
        "args": [
          "develop",
          "${workspaceFolder:[environment]}",
          "--command",
          "fish"
        ],
      }
    },
    "terminal.integrated.profiles.osx": {
      "fish [nix develop]": {
        "path": "nix",
        "args": [
          "develop",
          "${workspaceFolder:[environment]}",
          "--command",
          "fish"
        ],
      }
    },
    "rust-analyzer.server.path": "rust-analyzer-wrapper",
    "rust-analyzer.server.extraEnv": {
      "RUST_ANALYZER_WRAPPER_NIX_FLAKE_PATH": ".",
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Rebuild NSS",
        "group": "build",
        "type": "shell",
        "command": "${workspaceFolder:[environment]}/bin/rebuild-nss.sh",
        "options": {
          "cwd": "${workspaceFolder:application-services}",
          "shell": {
            "executable": "nix develop",
            "args": [
              "${workspaceFolder:[environment]}",
            ]
          }
        }
      }
    ]
  }
}
