#!/usr/bin/env bash
# Any copyright is dedicated to the Public Domain.
# http://creativecommons.org/publicdomain/zero/1.0/

set -eo pipefail

OS=$1

is_wsl() {
    [[ -n "${WSL_DISTRO_NAME:-}" ]]
}

if [[ -f ~/.config/fish/config.fish ]]; then
    rm -rf -- ~/.config/fish
fi

stow --no-folding -t ~ -d dotfiles/layers/base .
stow --no-folding -t ~ -d dotfiles/layers/posix .

if [[ "$OS" = "macos" ]]; then
    stow --no-folding -t ~ -d dotfiles/layers/macOS .
elif is_wsl; then
    stow --no-folding -t ~ -d dotfiles/layers/wsl .
fi
